  "approvedExceptions": [
    {
      "surface": "Temporary local GDS package source",
      "reason": "The public npm registry still returns 404 for the @doneisbetter package line from this workspace. Habigoal consumes the sibling GDS checkout until the packages are available from the approved registry.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    },
    {
      "surface": "Recharts chart internals",
      "reason": "Chart rendering remains outside canonical GDS component ownership; GDS should own surrounding containers, states, labels, spacing, and actions.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    },
    {
      "surface": "PDF generation internals",
      "reason": "PDF output uses jsPDF layout primitives and print-specific constraints; GDS should own report action semantics and high-level content hierarchy.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    },
    {
      "surface": "Public news content files",
      "reason": "News posts are structured localized content, not reusable UI primitives; GDS should own article shell and public surface framing.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    },
    {
      "surface": "Provider-branded OAuth controls",
      "reason": "SSO provider controls may require provider-specific brand constraints while remaining framed by GDS auth shell contracts.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    },
    {
      "surface": "Print-only report styles",
      "reason": "Print media needs flattened page-safe styles that differ from screen surfaces; exceptions must stay scoped to print/export selectors.",
      "owner": "habigoal",
      "reviewDate": "2026-06-02"
    }
  ],
  "compliance": {
    "documentationPaths": [
