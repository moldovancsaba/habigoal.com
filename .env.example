# MongoDB Atlas driver connection string
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/?appName=habigoal
MONGODB_DB=habigoal
MONGODB_APP_NAME=habigoal
IMGBB_API_KEY=

APP_URL=https://habigoal.com
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_BASE_URL=https://sso.doneisbetter.com
SSO_REDIRECT_URI=https://habigoal.com/api/oauth/callback
SSO_LOGOUT_URL=
AUTH_SECRET=
HABIGOAL_ENFORCE_AUTH=true

# Shared secret for the scheduled queue drain (GET /api/cron/queue).
# Vercel Cron automatically sends this as `Authorization: Bearer <CRON_SECRET>`.
# The endpoint returns 503 when unset (never an open trigger).
CRON_SECRET=

# Oura wearable integration (connect flow: docs/wearable-oauth.md; sync:
# docs/wearable-sync.md). The Oura OAuth callback and connector report "not
# configured" until both credentials are set. Register this redirect URI with
# the Oura application: {APP_BASE_URL}/api/oauth/wearable/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_API_BASE_URL=https://api.ouraring.com

# Whoop wearable integration (same connect/sync flow as Oura). The Whoop OAuth
# callback and connector report "not configured" until both credentials are set.
# Register this redirect URI with the Whoop application:
# {APP_BASE_URL}/api/oauth/wearable/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_API_BASE_URL=https://api.prod.whoop.com
